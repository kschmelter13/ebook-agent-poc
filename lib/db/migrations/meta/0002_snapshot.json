          "name": "ebook_revision_number_positive",
          "value": "\"ebook_revision\".\"revision_number\" > 0"
        },
        "ebook_revision_parent_shape": {
          "name": "ebook_revision_parent_shape",
          "value": "(\"ebook_revision\".\"revision_number\" = 1 AND \"ebook_revision\".\"parent_revision_id\" IS NULL) OR (\"ebook_revision\".\"revision_number\" > 1 AND \"ebook_revision\".\"parent_revision_id\" IS NOT NULL)"
        },
        "ebook_revision_page_count_range": {
          "name": "ebook_revision_page_count_range",
          "value": "\"ebook_revision\".\"page_count\" IS NULL OR \"ebook_revision\".\"page_count\" BETWEEN 10 AND 50"
        },
        "ebook_revision_status_shape": {
          "name": "ebook_revision_status_shape",
          "value": "\n        (\"ebook_revision\".\"status\" = 'pending' AND \"ebook_revision\".\"completed_at\" IS NULL AND \"ebook_revision\".\"error_message\" IS NULL)\n        OR\n        (\"ebook_revision\".\"status\" = 'failed' AND \"ebook_revision\".\"completed_at\" IS NULL AND \"ebook_revision\".\"error_message\" IS NOT NULL)\n        OR\n        (\"ebook_revision\".\"status\" = 'complete' AND \"ebook_revision\".\"completed_at\" IS NOT NULL AND \"ebook_revision\".\"error_message\" IS NULL\n          AND \"ebook_revision\".\"page_count\" IS NOT NULL AND \"ebook_revision\".\"pdf_url\" IS NOT NULL\n          AND \"ebook_revision\".\"source_url\" IS NOT NULL AND \"ebook_revision\".\"cover_source\" IS NOT NULL\n          AND \"ebook_revision\".\"storage\" IS NOT NULL)\n      "
        }
